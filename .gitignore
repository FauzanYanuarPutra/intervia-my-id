# =============================================================================
# Lajukan repository ignore rules
# =============================================================================

# OS / editors
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*.tmp
*.orig
*.iml
.vscode/
.idea/

# Environment / secrets
.env
.env.*
!.env.example
!.env.development.example
!.env.staging.example
!.env.production.example
.npmrc

# Local runtime, cache, recovery and generated audit output
/.runtime/
/.cache/
/.backups/
/audit_output/
**/.runtime/
**/.cache/
**/.npm-cache/

# Historical root database dumps: migrations remain allowed elsewhere.
/community.sql
/community_utf8.sql
/identity.sql
/identity_utf8.sql
/marketplace.sql
/marketplace_utf8.sql
*.dump
*.dump.gz
*.backup
*.backup.gz
*.sql.gz
*.sql.bak

# Logs / process state
*.log
*.pid
*.pid.lock
*.cache
*.temp
*.old
*.bak

