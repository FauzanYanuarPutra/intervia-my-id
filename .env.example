# =============================================================================
# Lajukan environment reference
# Copy the environment-specific example instead of using this file directly.
# Never commit real credentials.
# =============================================================================

COMPOSE_PROFILES=
COMPOSE_PROJECT_NAME=lajukan
ENV=development
APP_ENV=development
APP_NAME=Lajukan
APP_VERSION=0.1.0
APP_DOMAIN=localhost
ADMIN_EMAIL=ops@example.com
RUST_LOG=info

# Infrastructure image compatibility pins/defaults
MEILI_IMAGE=getmeili/meilisearch:v1.5
MINIO_IMAGE=minio/minio
OLLAMA_IMAGE=ollama/ollama:latest
NODE_ENV=production

# Public URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WWW_URL=http://localhost:3000
NEXT_PUBLIC_CRM_URL=http://localhost:3002
NEXT_PUBLIC_USAHA_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Database / cache / messaging
DB_USER=lajukan
DB_PASS=replace-me
REDIS_PASS=replace-me
RABBIT_USER=lajukan
RABBIT_PASS=replace-me
MEILI_KEY=replace-me
MINIO_USER=lajukan
MINIO_PASS=replace-me

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=laju
JWT_AUDIENCE=laju_users
SECRET_KEY_BASE=replace-with-a-long-random-secret
ACCESS_TOKEN_EXP_HOURS=1
REFRESH_TOKEN_EXP_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MIN=15
FAILED_LOGIN_DELAY_MS=1000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Migrations
RUN_MIGRATIONS_IDENTITY=true
RUN_MIGRATIONS_MARKETPLACE=true
RUN_MIGRATIONS_COMMUNITY=true

# Eventing
IDENTITY_OUTBOX_EXCHANGE=identity.outbox
IDENTITY_OUTBOX_BATCH_SIZE=50
IDENTITY_OUTBOX_POLL_MS=750
COMMUNITY_IDENTITY_QUEUE=community.identity.profile
OUTBOX_EXCHANGE=marketplace.outbox
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1500

# Wallet / payment flags. Keep production disabled until its runbook passes.
PAYMENTS_ENABLED=false
ORDER_ENGINE_API_ENABLED=false
WALLET_DEFAULT_ENV=development
WALLET_LIVE_ENABLED=false
WALLET_DEFAULT_PROVIDER=midtrans
WALLET_DEV_AUTO_SETTLE=true
WALLET_ALLOW_LIVE_IN_NON_PROD=false
WALLET_ALLOW_MOCK_IN_LIVE=false
WALLET_MIDTRANS_FALLBACK_TO_MOCK=true
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_SERVER_KEY_SANDBOX=
MIDTRANS_SERVER_KEY_LIVE=
MIDTRANS_PAYMENT_NOTIFICATION_URL=
WALLET_MIDTRANS_NOTIFICATION_URL=
MIDTRANS_FINISH_REDIRECT_URL=
MIDTRANS_UNFINISH_REDIRECT_URL=
MIDTRANS_ERROR_REDIRECT_URL=
WALLET_MIDTRANS_FINISH_REDIRECT_URL=
WALLET_MIDTRANS_UNFINISH_REDIRECT_URL=
WALLET_MIDTRANS_ERROR_REDIRECT_URL=

# Chat / Scylla
PHX_HOST=localhost
SCYLLA_IMAGE=scylladb/scylla:2025.2
SCYLLA_KEYSPACE=laju_chat
SCYLLA_NODES=
SCYLLA_PORT=9042
SCYLLA_USERNAME=
SCYLLA_PASSWORD=
SCYLLA_SSL=0

# AI / KYC
AI_SERVICE_TOKEN=replace-me
RAG_SERVICE_TOKEN=replace-me
USE_OLLAMA=false
SUPPORT_AI_USE_OLLAMA=false
OLLAMA_URL=http://ollama:11434
CHAT_OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_BUSINESS_MODEL=llama3.2:3b
OLLAMA_SUPPORT_MODEL=
OLLAMA_KEEP_ALIVE=10m
OLLAMA_SUPPORT_TIMEOUT_MS=8000
VLLM_CHAT_URL=
VLLM_MODELS_URL=
VLLM_API_KEY=
VLLM_MODEL=
VLLM_STRUCTURED_MODEL=
VLLM_VISION_MODEL=
VLLM_KYC_MODEL=
OCR_URL=http://ocr_service:8000
LIVENESS_URL=http://liveness_service:8000
FACE_MATCH_URL=
RAG_URL=

# Object storage / chat media
MINIO_PUBLIC_URL=
CHAT_MEDIA_ALLOWED_ORIGINS=

# Mail
EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Deployment images
DOCKERHUB_NAMESPACE=
IMAGE_TAG=

# Optional host ports for development
PORT_IDENTITY_DB=5432
PORT_COMMUNITY_DB=5433
PORT_MARKETPLACE_DB=5434
PORT_REDIS=6379
PORT_RABBITMQ=5672
PORT_RABBITMQ_UI=15672
PORT_SCYLLA=9042
PORT_MEILI=7700
PORT_MINIO_API=9002
PORT_MINIO_UI=9005
PORT_IDENTITY=8080
PORT_MARKETPLACE=8081
PORT_COMMUNITY=8082
PORT_CHAT=4000
PORT_AI_SERVICE=8084
PORT_OCR=8001
PORT_LIVENESS=8002
PORT_FRONTEND=3000
PORT_CMS=3001
PORT_CRM=3002
PORT_USAHA=3003
PORT_MAILHOG_SMTP=1025
PORT_MAILHOG_UI=8025
PORT_OLLAMA=11434
