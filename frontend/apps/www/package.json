{
  "name": "www",
  "version": "0.1.0",
  "private": true,
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "export": "next export",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:flow": "playwright test tests/e2e/lajukan-critical-flow.spec.ts",
    "test:ux": "vitest run src/lib/ux/indonesiaFlow.test.ts src/components/constants/z-index.test.ts && playwright test tests/e2e/lajukan-critical-flow.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:self-heal": "node scripts/self-heal-e2e.mjs",
    "test:e2e:quality": "playwright test tests/e2e/site-quality.spec.ts tests/e2e/lajukan-stabilization.spec.ts",
    "quality:source": "node scripts/check-source-health.mjs",
    "test:foundation": "vitest run src/lib/auth/oauthRedirects.test.ts src/lib/performance/webVitals.test.ts src/lib/reels/performance.test.ts src/lib/reels/preferences.test.ts src/lib/reels/presentation.test.ts src/lib/seo/jsonLd.test.ts src/lib/server/safeLog.test.ts src/lib/server/uploadFiles.test.ts src/lib/viewport/viewportMetrics.test.ts",
    "quality:foundation": "npm run quality:source && npm run test:foundation && tsc --noEmit --pretty false",
    "media:public-references": "node scripts/enrich-public-reference-media.mjs",
    "test:public-reference-media": "vitest run src/lib/server/publicReferenceMediaEnrichment.test.ts",
    "ai:dataset:pull": "node scripts/pull-lajukan-ai-domain-dataset.mjs",
    "ai:dataset:pull:full": "node scripts/pull-lajukan-ai-domain-dataset.mjs --include-open-food-facts=true",
    "i18n:audit": "node scripts/audit-i18n-copy.mjs",
    "i18n:audit:strict": "node scripts/audit-i18n-copy.mjs --strict"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@heroicons/react": "^2.2.0",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "embla-carousel-react": "^8.6.0",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.23.24",
    "ioredis": "^5.8.2",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "lajukan-ui": "file:../../packages",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.32.0",
    "next": "^16.0.7",
    "next-intl": "^4.5.0",
    "next-pwa": "^2.0.2",
    "nodemailer": "^9.0.2",
    "pg": "^8.20.0",
    "phoenix": "^1.8.3",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-intersection-observer": "^11.0.0",
    "react-leaflet": "^5.0.0",
    "react-masonry-css": "^1.0.16",
    "react-swipeable": "^7.0.2",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cannon": "^0.1.13",
    "@types/crypto-js": "^4.2.2",
    "@types/json-schema": "^7.0.15",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^6.4.21",
    "@types/pg": "^8.18.0",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}