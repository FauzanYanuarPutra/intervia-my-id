APP_NAME=Lajukan
APP_PORT=8080
ENV=development
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/laju_db

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT
JWT_SECRET=lajukan_super_secure_vault_key_2026_jakarta_v1_top_secret
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Email SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# Untuk Gmail, gunakan App Password: https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-specific-password
FROM_EMAIL=noreply@lajukan.com
FROM_NAME=Lajukan

# Frontend URLs
# Development
#FRONTEND_URL=http://localhost:3000
#CORS_ORIGIN=http://localhost:3000

# Production
FRONTEND_URL=https://www.lajukan.com
CORS_ORIGIN=https://www.lajukan.com

# Security
RATE_LIMIT_MAX=100          # Maksimum request per window
RATE_LIMIT_WINDOW=60        # Window dalam detik
RUST_LOG=info              # Logging level (debug, info, warn, error)