# Copy to .env.staging and adjust values
ENV=staging
APP_ENV=staging
APP_NAME=Lajukan
APP_DOMAIN=staging.example.com
ADMIN_EMAIL=admin@staging.example.com
APP_VERSION=0.1.0
RUST_LOG=info

JWT_SECRET=replace_with_strong_secret
JWT_ISSUER=laju
JWT_AUDIENCE=laju_users

DB_USER=app
DB_PASS=replace_with_db_password
DB_NAME=laju_db_staging

REDIS_PASS=replace_with_redis_password
RABBIT_USER=identity_service
RABBIT_PASS=replace_with_rabbitmq_password
MEILI_KEY=replace_with_meili_key

MINIO_USER=laju_admin
MINIO_PASS=replace_with_minio_password

PORT_FRONTEND=3000
PORT_USAHA=3003
PORT_CMS=3001
PORT_CRM=3002
PORT_MARKETPLACE=8081

FRONTEND_URL=https://staging.example.com
CORS_ORIGIN=https://staging.example.com,https://usaha.staging.example.com,https://cms.staging.example.com,https://crm.staging.example.com
CORS_ORIGINS=https://staging.example.com,https://usaha.staging.example.com,https://cms.staging.example.com,https://crm.staging.example.com

NEXT_PUBLIC_APP_URL=https://staging.example.com
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_API_URL=https://auth.staging.example.com
NEXT_PUBLIC_MARKETPLACE_URL=https://api.staging.example.com
NEXT_PUBLIC_MARKETPLACE_WS_URL=wss://api.staging.example.com
NEXT_PUBLIC_CHAT_WS_URL=wss://chat.staging.example.com/socket
NEXT_PUBLIC_WWW_URL=https://staging.example.com
NEXT_PUBLIC_USAHA_URL=https://usaha.staging.example.com
NEXT_PUBLIC_CMS_URL=https://cms.staging.example.com
NEXT_PUBLIC_CRM_URL=https://crm.staging.example.com

INTERNAL_API_URL=http://identity_service:8080
INTERNAL_MARKETPLACE_URL=http://marketplace_service:8081
INTERNAL_CHAT_URL=http://chat_service:4000
REWARD_MEMORY_FALLBACK=false

# UMKM shipping quotes. Staging may call RajaOngkir with a staging/test key when
# available; if key/origin/destination is missing the app falls back to estimates.
# Use the Komerce/RajaOngkir "Shipping Cost" key here. Payment API / QRISLY keys
# stay out of RAJAONGKIR_* because checkout payment still uses Lajukan wallet/Midtrans.
UMKM_SHIPPING_PROVIDER=rajaongkir
UMKM_SHIPPING_ENV=sandbox
UMKM_SHIPPING_ENABLE_PROVIDER_API=true
RAJAONGKIR_STAGING_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_STAGING_API_KEY=replace_with_rajaongkir_staging_key
RAJAONGKIR_DEFAULT_ORIGIN_ID=501
RAJAONGKIR_DEFAULT_COURIERS=jne,sicepat,jnt,anteraja,pos,tiki
UMKM_SHIPPING_BASE_FEE_CENTS=1200000
UMKM_SHIPPING_PER_KM_CENTS=180000
UMKM_SHIPPING_PER_KG_CENTS=90000
UMKM_SHIPPING_EXPRESS_SURCHARGE_CENTS=350000
UMKM_SHIPPING_SAME_DAY_SURCHARGE_CENTS=600000
UMKM_SHIPPING_SAME_DAY_MAX_KM=18
UMKM_SHIPPING_FALLBACK_DISTANCE_KM=8

# Wallet & payments. Staging uses Midtrans Sandbox through the existing Lajukan
# wallet/top-up flow. Put the sandbox Merchant ID, Client Key, and Server Key in
# the real .env.staging file only; never commit actual keys into this example.
WALLET_DEFAULT_ENV=development
WALLET_LIVE_ENABLED=false
WALLET_DEFAULT_PROVIDER=midtrans
WALLET_DEV_AUTO_SETTLE=false
WALLET_ALLOW_LIVE_IN_NON_PROD=false
WALLET_ALLOW_MOCK_IN_LIVE=false
WALLET_MIDTRANS_FALLBACK_TO_MOCK=false
MIDTRANS_MERCHANT_ID=replace_with_midtrans_sandbox_merchant_id
MIDTRANS_CLIENT_KEY=replace_with_midtrans_sandbox_client_key
MIDTRANS_SERVER_KEY_SANDBOX=replace_with_midtrans_sandbox_server_key
MIDTRANS_SERVER_KEY_LIVE=
MIDTRANS_PAYMENT_NOTIFICATION_URL=https://staging.example.com/api/wallet/providers/midtrans/notify
WALLET_MIDTRANS_NOTIFICATION_URL=https://staging.example.com/api/wallet/providers/midtrans/notify
MIDTRANS_FINISH_REDIRECT_URL=https://staging.example.com/payments?topup_status=finish
MIDTRANS_UNFINISH_REDIRECT_URL=https://staging.example.com/payments?topup_status=unfinish
MIDTRANS_ERROR_REDIRECT_URL=https://staging.example.com/payments?topup_status=error
WALLET_MIDTRANS_FINISH_REDIRECT_URL=https://staging.example.com/payments?topup_status=finish
WALLET_MIDTRANS_UNFINISH_REDIRECT_URL=https://staging.example.com/payments?topup_status=unfinish
WALLET_MIDTRANS_ERROR_REDIRECT_URL=https://staging.example.com/payments?topup_status=error

EMAIL_TRANSPORT=smtp
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_pass
SMTP_FROM=Lajukan Staging <no-reply@staging.example.com>
FROM_EMAIL=no-reply@staging.example.com
FROM_NAME=Lajukan Staging

DOCKERHUB_NAMESPACE=replace_with_dockerhub_username
IMAGE_TAG=staging
