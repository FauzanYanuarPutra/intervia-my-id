# Template only. Store real staging secrets outside Git.
COMPOSE_PROFILES=
COMPOSE_PROJECT_NAME=lajukan_staging
ENV=staging
APP_ENV=staging
APP_NAME=Lajukan
APP_VERSION=0.1.0
APP_DOMAIN=staging.lajukan.com
ADMIN_EMAIL=ops@lajukan.com
RUST_LOG=info
LOG_FORMAT=json

# Infrastructure image compatibility pins/defaults
MEILI_IMAGE=getmeili/meilisearch:v1.5
MINIO_IMAGE=quay.io/minio/minio
OLLAMA_IMAGE=ollama/ollama:latest
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.3
NODE_ENV=production

FRONTEND_URL=https://www.staging.lajukan.com
NEXT_PUBLIC_APP_URL=https://www.staging.lajukan.com
NEXT_PUBLIC_WWW_URL=https://www.staging.lajukan.com
NEXT_PUBLIC_CRM_URL=https://crm.staging.lajukan.com
NEXT_PUBLIC_USAHA_URL=https://usaha.staging.lajukan.com
NEXT_PUBLIC_API_URL=https://api.staging.lajukan.com
NEXT_PUBLIC_MARKETPLACE_URL=https://api.staging.lajukan.com
CORS_ORIGINS=https://www.staging.lajukan.com,https://usaha.staging.lajukan.com,https://cms.staging.lajukan.com,https://crm.staging.lajukan.com
CORS_ORIGIN=https://www.staging.lajukan.com

DB_USER=lajukan
DB_PASS=replace-with-staging-secret
IDENTITY_DB_MAX_CONNECTIONS=10
IDENTITY_DB_MIN_CONNECTIONS=1
IDENTITY_DB_ACQUIRE_TIMEOUT_SECONDS=5
IDENTITY_DB_IDLE_TIMEOUT_SECONDS=300
IDENTITY_DB_MAX_LIFETIME_SECONDS=1800
MARKETPLACE_DB_MAX_CONNECTIONS=20
MARKETPLACE_DB_MIN_CONNECTIONS=2
MARKETPLACE_DB_ACQUIRE_TIMEOUT_SECONDS=5
MARKETPLACE_DB_IDLE_TIMEOUT_SECONDS=300
MARKETPLACE_DB_MAX_LIFETIME_SECONDS=1800
COMMUNITY_DB_MAX_CONNECTIONS=20
COMMUNITY_DB_MIN_CONNECTIONS=2
COMMUNITY_DB_ACQUIRE_TIMEOUT_SECONDS=5
COMMUNITY_DB_IDLE_TIMEOUT_SECONDS=300
COMMUNITY_DB_MAX_LIFETIME_SECONDS=1800
IDENTITY_HTTP_MAX_IN_FLIGHT=512
MARKETPLACE_HTTP_MAX_IN_FLIGHT=512
MARKETPLACE_IDENTITY_TIMEOUT_MS=2000
COMMUNITY_HTTP_MAX_IN_FLIGHT=512
REDIS_PASS=replace-with-staging-secret
RABBIT_USER=lajukan
RABBIT_PASS=replace-with-staging-secret
MEILI_KEY=replace-with-staging-secret
MINIO_USER=lajukan
MINIO_PASS=replace-with-staging-secret
JWT_SECRET=replace-with-long-staging-secret
# Optional asymmetric access-token rollout. PEM may use literal \\n escapes.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KEY_ID=lajukan-primary
JWT_ALLOW_LEGACY_HS256=true
JWT_ISSUER=laju
JWT_AUDIENCE=laju_users
SECRET_KEY_BASE=replace-with-long-staging-secret
AI_SERVICE_TOKEN=replace-with-staging-secret
RAG_SERVICE_TOKEN=replace-with-staging-secret

ACCESS_TOKEN_EXP_HOURS=1
REFRESH_TOKEN_EXP_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MIN=15
FAILED_LOGIN_DELAY_MS=1000
AUTH_PASSWORD_MIN_LENGTH=15
ALLOW_BEARER_AUTH=true
ENABLE_OTP_AUTH=true
ENABLE_PHONE_AUTH=false
LOGIN_OTP_REQUIRED=true
LOGIN_PHONE_OTP_REQUIRED=true
REGISTER_OTP_REQUIRED=true
REGISTER_PHONE_OTP_REQUIRED=true
NEXT_PUBLIC_LOGIN_OTP_REQUIRED=true
NEXT_PUBLIC_IMAGE_AI_ASSIST_ENABLED=false
NEXT_PUBLIC_DISABLE_PWA=false
REGISTER_RATE_LIMIT_PER_HOUR=12
REGISTER_USERNAME_RATE_LIMIT_PER_HOUR=3
LOGIN_RATE_LIMIT_PER_15_MIN=15
LOGIN_USERNAME_RATE_LIMIT_PER_15_MIN=5
OTP_LIMIT_PER_TARGET_PER_HOUR=5
OTP_LIMIT_PER_IP_PER_HOUR=30
REDIS_CONNECTION_NAME=lajukan-www
AI_LEARNING_ENABLED=false
AI_LEARNING_LOG_DIR=/app/apps/www/.runtime/ai-learning
AI_LEARNING_MEMORY_FILE=/app/apps/www/.runtime/ai-learning/create-from-image-memory.json
PERSONAL_AI_STORE_DIR=/app/apps/www/.runtime/personal-ai
PERSONAL_AI_ALLOW_FILE_STORE=false
IMAGE_AI_ASSIST_ENABLED=false

# Shared Google OAuth Web client. WWW and Usaha use the same credential with
# explicit app-specific callbacks. NEXTAUTH_URL/AUTH_URL are not used.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WWW_GOOGLE_REDIRECT_URI=https://www.staging.lajukan.com/api/auth/google/callback
USAHA_GOOGLE_REDIRECT_URI=https://usaha.staging.lajukan.com/api/auth/google/callback

CLOUDFLARE_TUNNEL_TOKEN=

IDENTITY_OUTBOX_EXCHANGE=identity.outbox
IDENTITY_OUTBOX_BATCH_SIZE=50
IDENTITY_OUTBOX_POLL_MS=750
COMMUNITY_IDENTITY_QUEUE=community.identity.profile
COMMUNITY_IDENTITY_PREFETCH=100
OUTBOX_EXCHANGE=marketplace.outbox
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1500
OUTBOX_MAX_RETRIES=20

PAYMENTS_ENABLED=false
ORDER_ENGINE_API_ENABLED=false
WALLET_DEFAULT_ENV=development
WALLET_LIVE_ENABLED=false
WALLET_DEFAULT_PROVIDER=midtrans
WALLET_DEV_AUTO_SETTLE=false
WALLET_ALLOW_LIVE_IN_NON_PROD=false
WALLET_ALLOW_MOCK_IN_LIVE=false
WALLET_MIDTRANS_FALLBACK_TO_MOCK=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_SERVER_KEY_SANDBOX=
MIDTRANS_SERVER_KEY_LIVE=
MIDTRANS_PAYMENT_NOTIFICATION_URL=https://staging.lajukan.com/api/wallet/providers/midtrans/notify
WALLET_MIDTRANS_NOTIFICATION_URL=https://staging.lajukan.com/api/wallet/providers/midtrans/notify
MIDTRANS_FINISH_REDIRECT_URL=https://staging.lajukan.com/id/payments
MIDTRANS_UNFINISH_REDIRECT_URL=https://staging.lajukan.com/id/payments
MIDTRANS_ERROR_REDIRECT_URL=https://staging.lajukan.com/id/payments
WALLET_MIDTRANS_FINISH_REDIRECT_URL=https://staging.lajukan.com/id/payments
WALLET_MIDTRANS_UNFINISH_REDIRECT_URL=https://staging.lajukan.com/id/payments
WALLET_MIDTRANS_ERROR_REDIRECT_URL=https://staging.lajukan.com/id/payments

PHX_HOST=staging.lajukan.com
SCYLLA_IMAGE=scylladb/scylla:2025.2
SCYLLA_KEYSPACE=laju_chat
SCYLLA_NODES=
SCYLLA_PORT=9042
SCYLLA_USERNAME=
SCYLLA_PASSWORD=
SCYLLA_SSL=0

USE_OLLAMA=false
SUPPORT_AI_USE_OLLAMA=false
OLLAMA_URL=http://ollama:11434
CHAT_OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_BUSINESS_MODEL=llama3.2:3b
OLLAMA_SUPPORT_MODEL=
OLLAMA_KEEP_ALIVE=10m
OLLAMA_SUPPORT_TIMEOUT_MS=8000
VLLM_URL=https://ai-provider.staging.example.com/v1
VLLM_API_KEY=
VLLM_MODEL=
AI_MODEL=
VLLM_STRUCTURED_MODEL=
VLLM_VISION_MODEL=
VLLM_KYC_MODEL=
AI_MAX_CONCURRENT=8
OCR_URL=http://ocr_service:8000/predict
LIVENESS_URL=http://liveness_service:8000/check
LIVENESS_MODELS_PATH=./.runtime/models/liveness
FACE_MATCH_URL=
RAG_URL=
MINIO_PUBLIC_URL=https://media.staging.lajukan.com
CHAT_MEDIA_ALLOWED_ORIGINS=https://staging.lajukan.com

# WhatsApp Meta staging contract. Replace placeholders only in runtime secrets.
WHATSAPP_META_ACCESS_TOKEN=replace-with-staging-secret
WHATSAPP_META_PHONE_NUMBER_ID=replace-with-staging-phone-number-id
WHATSAPP_META_API_VERSION=v22.0
WHATSAPP_META_DEFAULT_COUNTRY_CODE=62
WHATSAPP_META_OTP_MODE=template
WHATSAPP_META_OTP_TEMPLATE_NAME=replace-with-approved-staging-otp-template
WHATSAPP_META_OTP_TEMPLATE_LANGUAGE=id
WHATSAPP_META_OTP_TEMPLATE_BUTTON_SUB_TYPE=
WHATSAPP_META_OTP_TEMPLATE_BUTTON_INDEX=0
WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=replace-with-random-staging-verify-token
WHATSAPP_META_APP_SECRET=replace-with-staging-secret
WHATSAPP_META_WEBHOOK_REQUIRE_SIGNATURE=true

EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-staging-user
SMTP_PASS=replace-with-staging-secret
SMTP_FROM="Lajukan Staging <noreply@staging.lajukan.com>"
FROM_EMAIL=noreply@staging.lajukan.com
FROM_NAME=Lajukan

DOCKERHUB_NAMESPACE=lajukan-ci
IMAGE_TAG=sha-ci

# Private observability UI. Keep loopback-only and use SSH/private admin access.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-observability-admin-secret
GRAFANA_PORT=3005
