# Template only. DO NOT place real production secrets in Git.
COMPOSE_PROFILES=
COMPOSE_PROJECT_NAME=lajukan_prod
ENV=production
APP_ENV=production
APP_NAME=Lajukan
APP_VERSION=0.1.0
APP_DOMAIN=lajukan.com
ADMIN_EMAIL=ops@lajukan.com
RUST_LOG=warn

# Infrastructure image compatibility pins/defaults
MEILI_IMAGE=getmeili/meilisearch:v1.5
MINIO_IMAGE=minio/minio
SCYLLA_IMAGE=scylladb/scylla:2025.2
OLLAMA_IMAGE=ollama/ollama:latest
NODE_ENV=production

FRONTEND_URL=https://www.lajukan.com
NEXT_PUBLIC_APP_URL=https://www.lajukan.com
NEXT_PUBLIC_WWW_URL=https://www.lajukan.com
NEXT_PUBLIC_CRM_URL=https://crm.lajukan.com
NEXT_PUBLIC_USAHA_URL=https://usaha.lajukan.com
NEXT_PUBLIC_API_URL=https://api.lajukan.com
NEXT_PUBLIC_MARKETPLACE_URL=https://api.lajukan.com
CORS_ORIGINS=https://www.lajukan.com,https://usaha.lajukan.com,https://cms.lajukan.com,https://crm.lajukan.com
CORS_ORIGIN=https://www.lajukan.com

DB_USER=lajukan
DB_PASS=replace-with-production-secret
REDIS_PASS=replace-with-production-secret
RABBIT_USER=lajukan
RABBIT_PASS=replace-with-production-secret
MEILI_KEY=replace-with-production-secret
MINIO_USER=lajukan
MINIO_PASS=replace-with-production-secret
JWT_SECRET=replace-with-long-production-secret
JWT_ISSUER=laju
JWT_AUDIENCE=laju_users
SECRET_KEY_BASE=replace-with-long-production-secret
AI_SERVICE_TOKEN=replace-with-production-secret
RAG_SERVICE_TOKEN=replace-with-production-secret

ACCESS_TOKEN_EXP_HOURS=1
REFRESH_TOKEN_EXP_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MIN=15
FAILED_LOGIN_DELAY_MS=1000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.lajukan.com/api/auth/google/callback

RUN_MIGRATIONS_IDENTITY=true
RUN_MIGRATIONS_MARKETPLACE=true
RUN_MIGRATIONS_COMMUNITY=true
IDENTITY_OUTBOX_EXCHANGE=identity.outbox
IDENTITY_OUTBOX_BATCH_SIZE=50
IDENTITY_OUTBOX_POLL_MS=750
COMMUNITY_IDENTITY_QUEUE=community.identity.profile
OUTBOX_EXCHANGE=marketplace.outbox
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1500

# FAIL-CLOSED financial defaults. Enable only after the production runbook passes.
PAYMENTS_ENABLED=false
ORDER_ENGINE_API_ENABLED=false
WALLET_DEFAULT_ENV=production
WALLET_LIVE_ENABLED=false
WALLET_DEFAULT_PROVIDER=midtrans
WALLET_DEV_AUTO_SETTLE=false
WALLET_ALLOW_LIVE_IN_NON_PROD=false
WALLET_ALLOW_MOCK_IN_LIVE=false
WALLET_MIDTRANS_FALLBACK_TO_MOCK=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_SERVER_KEY_SANDBOX=
MIDTRANS_SERVER_KEY_LIVE=
MIDTRANS_PAYMENT_NOTIFICATION_URL=https://www.lajukan.com/api/wallet/providers/midtrans/notify
WALLET_MIDTRANS_NOTIFICATION_URL=https://www.lajukan.com/api/wallet/providers/midtrans/notify
MIDTRANS_FINISH_REDIRECT_URL=https://www.lajukan.com/id/payments
MIDTRANS_UNFINISH_REDIRECT_URL=https://www.lajukan.com/id/payments
MIDTRANS_ERROR_REDIRECT_URL=https://www.lajukan.com/id/payments
WALLET_MIDTRANS_FINISH_REDIRECT_URL=https://www.lajukan.com/id/payments
WALLET_MIDTRANS_UNFINISH_REDIRECT_URL=https://www.lajukan.com/id/payments
WALLET_MIDTRANS_ERROR_REDIRECT_URL=https://www.lajukan.com/id/payments

PHX_HOST=lajukan.com
SCYLLA_KEYSPACE=laju_chat
SCYLLA_NODES=scylla-1.internal:9042,scylla-2.internal:9042,scylla-3.internal:9042
SCYLLA_PORT=9042
SCYLLA_USERNAME=
SCYLLA_PASSWORD=
SCYLLA_SSL=0

USE_OLLAMA=false
SUPPORT_AI_USE_OLLAMA=false
OLLAMA_URL=http://ollama:11434
CHAT_OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_BUSINESS_MODEL=llama3.2:3b
OLLAMA_SUPPORT_MODEL=
OLLAMA_KEEP_ALIVE=10m
OLLAMA_SUPPORT_TIMEOUT_MS=8000
VLLM_CHAT_URL=
VLLM_MODELS_URL=
VLLM_API_KEY=
VLLM_MODEL=
VLLM_STRUCTURED_MODEL=
VLLM_VISION_MODEL=
VLLM_KYC_MODEL=
OCR_URL=http://ocr_service:8000
LIVENESS_URL=http://liveness_service:8000
FACE_MATCH_URL=
RAG_URL=
MINIO_PUBLIC_URL=https://media.lajukan.com
CHAT_MEDIA_ALLOWED_ORIGINS=https://www.lajukan.com

EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-production-user
SMTP_PASS=replace-with-production-secret

DOCKERHUB_NAMESPACE=lajukan-ci
IMAGE_TAG=sha-ci
