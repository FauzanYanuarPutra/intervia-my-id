# Copy to .env.production and adjust values
ENV=production
APP_ENV=production
APP_NAME=Lajukan
APP_DOMAIN=www.lajukan.com
ADMIN_EMAIL=support@lajukan.com
APP_VERSION=1.0.0
RUST_LOG=warn

# Public business information shown on the website and useful for payment
# gateway review.
BUSINESS_PUBLIC_NAME=Lajukan
BUSINESS_SUPPORT_EMAIL=support@lajukan.com
BUSINESS_SUPPORT_PHONE=+6282117148623
BUSINESS_SUPPORT_WHATSAPP=https://wa.me/6282117148623
BUSINESS_DEFAULT_CURRENCY=IDR

JWT_SECRET=replace_with_very_strong_secret
JWT_ISSUER=laju
JWT_AUDIENCE=laju_users

DB_USER=app
DB_PASS=replace_with_db_password
DB_NAME=laju_db

REDIS_PASS=replace_with_redis_password
RABBIT_USER=identity_service
RABBIT_PASS=replace_with_rabbitmq_password
MEILI_KEY=replace_with_meili_key

MINIO_USER=laju_admin
MINIO_PASS=replace_with_minio_password

PORT_FRONTEND=3000
PORT_USAHA=3003
PORT_CMS=3001
PORT_CRM=3002
PORT_MARKETPLACE=8081

FRONTEND_URL=https://www.lajukan.com
CORS_ORIGIN=https://www.lajukan.com,https://usaha.lajukan.com,https://cms.lajukan.com,https://crm.lajukan.com
CORS_ORIGINS=https://www.lajukan.com,https://usaha.lajukan.com,https://cms.lajukan.com,https://crm.lajukan.com

NEXT_PUBLIC_APP_URL=https://www.lajukan.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_URL=https://www.lajukan.com
NEXT_PUBLIC_MARKETPLACE_URL=https://www.lajukan.com
NEXT_PUBLIC_MARKETPLACE_WS_URL=
NEXT_PUBLIC_CHAT_WS_URL=
NEXT_PUBLIC_COMMUNITY_URL=https://www.lajukan.com
NEXT_PUBLIC_WWW_URL=https://www.lajukan.com
NEXT_PUBLIC_USAHA_URL=https://usaha.lajukan.com
NEXT_PUBLIC_CMS_URL=https://cms.lajukan.com
NEXT_PUBLIC_CRM_URL=https://crm.lajukan.com

INTERNAL_API_URL=http://identity_service:8080
INTERNAL_MARKETPLACE_URL=http://marketplace_service:8081
INTERNAL_COMMUNITY_URL=http://community_service:8082
COMMUNITY_SERVICE_URL=http://community_service:8082
INTERNAL_CHAT_URL=http://chat_service:4000
REWARD_MEMORY_FALLBACK=false

# Username-password launch policy. Phone/OTP auth routes stay prepared but are
# disabled unless these flags are explicitly enabled.
ENABLE_PHONE_AUTH=false
ENABLE_OTP_AUTH=false
AUTH_PASSWORD_MIN_LENGTH=15
REGISTER_RATE_LIMIT_PER_HOUR=12
REGISTER_USERNAME_RATE_LIMIT_PER_HOUR=3
LOGIN_RATE_LIMIT_PER_15_MIN=15
LOGIN_USERNAME_RATE_LIMIT_PER_15_MIN=5

# Creator anti-spam budget. Starts each account with 1000 coins, grants daily
# coins once per Jakarta day, and spends 10 coins for create/edit actions.
CREATOR_INITIAL_COINS=1000
CREATOR_DAILY_COINS=50
CREATOR_ACTION_COST_COINS=10
CREATOR_DAILY_ACTION_LIMIT=10

UMKM_SHIPPING_BASE_FEE_CENTS=1200000
UMKM_SHIPPING_PER_KM_CENTS=180000
UMKM_SHIPPING_PER_KG_CENTS=90000
UMKM_SHIPPING_EXPRESS_SURCHARGE_CENTS=350000
UMKM_SHIPPING_SAME_DAY_SURCHARGE_CENTS=600000
UMKM_SHIPPING_SAME_DAY_MAX_KM=18
UMKM_SHIPPING_FALLBACK_DISTANCE_KM=8
# Use the Komerce/RajaOngkir "Shipping Cost" key here. Payment API / QRISLY keys
# stay out of RAJAONGKIR_* because checkout payment still uses Lajukan wallet/Midtrans.
UMKM_SHIPPING_PROVIDER=rajaongkir
UMKM_SHIPPING_ENV=live
UMKM_SHIPPING_ENABLE_PROVIDER_API=true
RAJAONGKIR_PRODUCTION_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_PRODUCTION_API_KEY=replace_with_rajaongkir_production_key
RAJAONGKIR_DEFAULT_ORIGIN_ID=replace_with_origin_destination_id
RAJAONGKIR_DEFAULT_COURIERS=jne,sicepat,jnt,anteraja,pos,tiki

# Wallet & payments. Production must use Midtrans live credentials only.
PAYMENTS_ENABLED=true
WALLET_DEFAULT_ENV=live
WALLET_LIVE_ENABLED=true
WALLET_DEFAULT_PROVIDER=midtrans
WALLET_DEV_AUTO_SETTLE=false
WALLET_ALLOW_LIVE_IN_NON_PROD=false
WALLET_ALLOW_MOCK_IN_LIVE=false
WALLET_MIDTRANS_FALLBACK_TO_MOCK=false
MIDTRANS_MERCHANT_ID=replace_with_midtrans_merchant_id
MIDTRANS_CLIENT_KEY=replace_with_midtrans_live_client_key
MIDTRANS_SERVER_KEY_SANDBOX=
MIDTRANS_SERVER_KEY_LIVE=replace_with_midtrans_live_server_key
MIDTRANS_PAYMENT_NOTIFICATION_URL=https://www.lajukan.com/api/wallet/providers/midtrans/notify
WALLET_MIDTRANS_NOTIFICATION_URL=https://www.lajukan.com/api/wallet/providers/midtrans/notify
MIDTRANS_FINISH_REDIRECT_URL=https://www.lajukan.com/id/payments
MIDTRANS_UNFINISH_REDIRECT_URL=https://www.lajukan.com/id/payments
MIDTRANS_ERROR_REDIRECT_URL=https://www.lajukan.com/id/payments
WALLET_MIDTRANS_FINISH_REDIRECT_URL=https://www.lajukan.com/id/payments
WALLET_MIDTRANS_UNFINISH_REDIRECT_URL=https://www.lajukan.com/id/payments
WALLET_MIDTRANS_ERROR_REDIRECT_URL=https://www.lajukan.com/id/payments

EMAIL_TRANSPORT=smtp
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_pass
SMTP_FROM=Lajukan <no-reply@example.com>
FROM_EMAIL=no-reply@example.com
FROM_NAME=Lajukan

# WhatsApp OTP via Meta Cloud API. Store real values only in production secrets.
WHATSAPP_META_ACCESS_TOKEN=replace_with_meta_whatsapp_access_token
WHATSAPP_META_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_META_API_VERSION=v22.0
WHATSAPP_META_DEFAULT_COUNTRY_CODE=62
WHATSAPP_META_OTP_MODE=template
WHATSAPP_META_OTP_TEMPLATE_NAME=replace_with_approved_otp_template
WHATSAPP_META_OTP_TEMPLATE_LANGUAGE=id
WHATSAPP_META_OTP_TEMPLATE_BUTTON_SUB_TYPE=
WHATSAPP_META_OTP_TEMPLATE_BUTTON_INDEX=0
WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=lajukan_verify_22012005
WHATSAPP_META_APP_SECRET=replace_with_meta_app_secret
WHATSAPP_META_WEBHOOK_REQUIRE_SIGNATURE=true

CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

DOCKERHUB_NAMESPACE=replace_with_dockerhub_username
IMAGE_TAG=latest
