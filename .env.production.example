# Copy to .env.production and adjust values
ENV=production
APP_ENV=production
APP_NAME=Lajukan
APP_DOMAIN=example.com
ADMIN_EMAIL=admin@example.com
APP_VERSION=1.0.0
RUST_LOG=warn

JWT_SECRET=replace_with_very_strong_secret
JWT_ISSUER=laju
JWT_AUDIENCE=laju_users

DB_USER=app
DB_PASS=replace_with_db_password
DB_NAME=laju_db

REDIS_PASS=replace_with_redis_password
RABBIT_USER=identity_service
RABBIT_PASS=replace_with_rabbitmq_password
MEILI_KEY=replace_with_meili_key

MINIO_USER=laju_admin
MINIO_PASS=replace_with_minio_password

PORT_FRONTEND=3000
PORT_USAHA=3003
PORT_CMS=3001
PORT_CRM=3002
PORT_MARKETPLACE=8081

FRONTEND_URL=https://example.com
CORS_ORIGIN=https://example.com,https://usaha.example.com,https://cms.example.com,https://crm.example.com
CORS_ORIGINS=https://example.com,https://usaha.example.com,https://cms.example.com,https://crm.example.com

NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_URL=https://auth.example.com
NEXT_PUBLIC_MARKETPLACE_URL=https://api.example.com
NEXT_PUBLIC_MARKETPLACE_WS_URL=wss://api.example.com
NEXT_PUBLIC_CHAT_WS_URL=wss://chat.example.com/socket
NEXT_PUBLIC_COMMUNITY_URL=https://community.example.com
NEXT_PUBLIC_WWW_URL=https://example.com
NEXT_PUBLIC_USAHA_URL=https://usaha.example.com
NEXT_PUBLIC_CMS_URL=https://cms.example.com
NEXT_PUBLIC_CRM_URL=https://crm.example.com

INTERNAL_API_URL=http://identity_service:8080
INTERNAL_MARKETPLACE_URL=http://marketplace_service:8081
INTERNAL_COMMUNITY_URL=http://community_service:8082
COMMUNITY_SERVICE_URL=http://community_service:8082
INTERNAL_CHAT_URL=http://chat_service:4000

UMKM_SHIPPING_BASE_FEE_CENTS=1200000
UMKM_SHIPPING_PER_KM_CENTS=180000
UMKM_SHIPPING_PER_KG_CENTS=90000
UMKM_SHIPPING_EXPRESS_SURCHARGE_CENTS=350000
UMKM_SHIPPING_SAME_DAY_SURCHARGE_CENTS=600000
UMKM_SHIPPING_SAME_DAY_MAX_KM=18
UMKM_SHIPPING_FALLBACK_DISTANCE_KM=8
# Use the Komerce/RajaOngkir "Shipping Cost" key here. Payment API / QRISLY keys
# stay out of RAJAONGKIR_* because checkout payment still uses Lajukan wallet/Midtrans.
UMKM_SHIPPING_PROVIDER=rajaongkir
UMKM_SHIPPING_ENV=live
UMKM_SHIPPING_ENABLE_PROVIDER_API=true
RAJAONGKIR_PRODUCTION_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_PRODUCTION_API_KEY=replace_with_rajaongkir_production_key
RAJAONGKIR_DEFAULT_ORIGIN_ID=replace_with_origin_destination_id
RAJAONGKIR_DEFAULT_COURIERS=jne,sicepat,jnt,anteraja,pos,tiki

# Wallet & payments. Production must use Midtrans live credentials only.
WALLET_DEFAULT_ENV=live
WALLET_LIVE_ENABLED=true
WALLET_DEFAULT_PROVIDER=midtrans
WALLET_DEV_AUTO_SETTLE=false
WALLET_ALLOW_LIVE_IN_NON_PROD=false
WALLET_ALLOW_MOCK_IN_LIVE=false
WALLET_MIDTRANS_FALLBACK_TO_MOCK=false
MIDTRANS_MERCHANT_ID=replace_with_midtrans_live_merchant_id
MIDTRANS_CLIENT_KEY=replace_with_midtrans_live_client_key
MIDTRANS_SERVER_KEY_SANDBOX=
MIDTRANS_SERVER_KEY_LIVE=replace_with_midtrans_live_server_key
MIDTRANS_PAYMENT_NOTIFICATION_URL=https://example.com/api/wallet/providers/midtrans/notify
WALLET_MIDTRANS_NOTIFICATION_URL=https://example.com/api/wallet/providers/midtrans/notify
MIDTRANS_FINISH_REDIRECT_URL=https://example.com/payments?topup_status=finish
MIDTRANS_UNFINISH_REDIRECT_URL=https://example.com/payments?topup_status=unfinish
MIDTRANS_ERROR_REDIRECT_URL=https://example.com/payments?topup_status=error
WALLET_MIDTRANS_FINISH_REDIRECT_URL=https://example.com/payments?topup_status=finish
WALLET_MIDTRANS_UNFINISH_REDIRECT_URL=https://example.com/payments?topup_status=unfinish
WALLET_MIDTRANS_ERROR_REDIRECT_URL=https://example.com/payments?topup_status=error

EMAIL_TRANSPORT=smtp
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_pass
SMTP_FROM=Lajukan <no-reply@example.com>
FROM_EMAIL=no-reply@example.com
FROM_NAME=Lajukan

CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiYzc2Zjg5OWJjMmFkMWNlNzJjNjYzNTZlZDkyOGFiNzMiLCJ0IjoiYzIxYzFhNDktMmFiZS00Mjk1LTg5OGMtMmVjZDU0ZTUxZDk0IiwicyI6Ik5tVTFOREU1TmpVdFpUazNPUzAwTVRsaUxUZ3pNbU10WmpRMllqZGlOVFU1TldRMSJ9

DOCKERHUB_NAMESPACE=replace_with_dockerhub_username
IMAGE_TAG=latest
