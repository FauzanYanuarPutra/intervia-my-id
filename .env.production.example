# Copy to .env.production and adjust values
ENV=production
APP_ENV=production
APP_NAME=Lajukan
APP_DOMAIN=example.com
ADMIN_EMAIL=admin@example.com
APP_VERSION=1.0.0
RUST_LOG=warn

JWT_SECRET=replace_with_very_strong_secret
JWT_ISSUER=laju
JWT_AUDIENCE=laju_users

DB_USER=app
DB_PASS=replace_with_db_password
DB_NAME=laju_db

REDIS_PASS=replace_with_redis_password
RABBIT_USER=identity_service
RABBIT_PASS=replace_with_rabbitmq_password
MEILI_KEY=replace_with_meili_key

MINIO_USER=laju_admin
MINIO_PASS=replace_with_minio_password

PORT_FRONTEND=3000
PORT_CMS=3001
PORT_CRM=3002
PORT_MARKETPLACE=8081

FRONTEND_URL=https://example.com
CORS_ORIGIN=https://example.com,https://cms.example.com,https://crm.example.com
CORS_ORIGINS=https://example.com,https://cms.example.com,https://crm.example.com

NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_URL=https://auth.example.com
NEXT_PUBLIC_MARKETPLACE_URL=https://api.example.com
NEXT_PUBLIC_MARKETPLACE_WS_URL=wss://api.example.com
NEXT_PUBLIC_CHAT_WS_URL=wss://chat.example.com/socket
NEXT_PUBLIC_WWW_URL=https://example.com
NEXT_PUBLIC_CMS_URL=https://cms.example.com
NEXT_PUBLIC_CRM_URL=https://crm.example.com

INTERNAL_API_URL=http://identity_service:8080
INTERNAL_MARKETPLACE_URL=http://marketplace_service:8081
INTERNAL_CHAT_URL=http://chat_service:4000

UMKM_SHIPPING_BASE_FEE_CENTS=1200000
UMKM_SHIPPING_PER_KM_CENTS=180000
UMKM_SHIPPING_PER_KG_CENTS=90000
UMKM_SHIPPING_EXPRESS_SURCHARGE_CENTS=350000
UMKM_SHIPPING_SAME_DAY_SURCHARGE_CENTS=600000
UMKM_SHIPPING_SAME_DAY_MAX_KM=18
UMKM_SHIPPING_FALLBACK_DISTANCE_KM=8

EMAIL_TRANSPORT=smtp
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_pass
SMTP_FROM=Lajukan <no-reply@example.com>
FROM_EMAIL=no-reply@example.com
FROM_NAME=Lajukan

CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

DOCKERHUB_NAMESPACE=replace_with_dockerhub_username
IMAGE_TAG=latest
