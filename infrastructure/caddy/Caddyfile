# Akses lokal langsung tanpa hostname www. Gunakan alamat IP agar blok ini
# tidak bentrok ketika APP_DOMAIN=localhost.
http://127.0.0.1 {
    @chat_socket path /socket /socket/*
    reverse_proxy @chat_socket chat_service:4000
    reverse_proxy www:3000
    encode gzip zstd
}

# Redirect domain utama ke www
http://{$APP_DOMAIN} {
    redir http://www.{$APP_DOMAIN}{uri} permanent
}

# Blok Utama: WWW
http://www.{$APP_DOMAIN} {
    @chat_socket path /socket /socket/*
    reverse_proxy @chat_socket chat_service:4000
    @notifications_socket path /v1/notifications/stream /v1/notifications/stream/*
    reverse_proxy @notifications_socket marketplace_service:8081
    reverse_proxy www:3000

    header {
        Content-Security-Policy "default-src 'self'; connect-src 'self' *.{$APP_DOMAIN} wss://www.{$APP_DOMAIN} wss://chat.{$APP_DOMAIN};"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    encode gzip zstd
}

http://usaha.{$APP_DOMAIN} {
    @chat_socket path /socket /socket/*
    reverse_proxy @chat_socket chat_service:4000
    @notifications_socket path /v1/notifications/stream /v1/notifications/stream/*
    reverse_proxy @notifications_socket marketplace_service:8081
    reverse_proxy usaha:3003

    header {
        Content-Security-Policy "default-src 'self'; connect-src 'self' *.{$APP_DOMAIN} wss://usaha.{$APP_DOMAIN} wss://chat.{$APP_DOMAIN};"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    encode gzip zstd
}

http://cms.{$APP_DOMAIN} {
    reverse_proxy cms:3001

    header {
        Content-Security-Policy "default-src 'self'; connect-src 'self' *.{$APP_DOMAIN};"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }
    encode gzip zstd
}

http://crm.{$APP_DOMAIN} {
    reverse_proxy crm:3002

    header {
        Content-Security-Policy "default-src 'self'; connect-src 'self' *.{$APP_DOMAIN} ws: wss:;"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }
    encode gzip zstd
}

# Service lain gunakan http:// agar tidak loop
http://auth.{$APP_DOMAIN} {
    reverse_proxy identity_service:8080
}

http://chat.{$APP_DOMAIN} {
    reverse_proxy chat_service:4000
}

http://cdn.{$APP_DOMAIN} {
    reverse_proxy minio:9002
}

http://console.{$APP_DOMAIN} {
    reverse_proxy minio:9001
}
