{
    email {$ADMIN_EMAIL}
    grace_period 30s
}

(access_log) {
    log {
        output stdout
        format filter {
            request>uri query {
                replace token REDACTED
                replace access_token REDACTED
                replace id_token REDACTED
                replace code REDACTED
                replace state REDACTED
                replace otp REDACTED
                replace signature REDACTED
            }
            wrap json
        }
    }
}

(security_headers) {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-Permitted-Cross-Domain-Policies "none"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    }
}

{$APP_DOMAIN} {
    import access_log
    redir https://www.{$APP_DOMAIN}{uri} permanent
}

www.{$APP_DOMAIN} {
    import access_log
    import security_headers
    @chat_socket path /socket /socket/*
    reverse_proxy @chat_socket chat_service:4000
    @notifications_socket path /v1/notifications/stream /v1/notifications/stream/*
    reverse_proxy @notifications_socket marketplace_service:8081
    reverse_proxy www:3000
    encode zstd gzip
}

usaha.{$APP_DOMAIN} {
    import access_log
    import security_headers
    @chat_socket path /socket /socket/*
    reverse_proxy @chat_socket chat_service:4000
    @notifications_socket path /v1/notifications/stream /v1/notifications/stream/*
    reverse_proxy @notifications_socket marketplace_service:8081
    reverse_proxy usaha:3003
    encode zstd gzip
}

api.{$APP_DOMAIN} {
    import access_log
    import security_headers

    # Service metrics are private; Prometheus reaches them over the internal network.
    @internal_metrics path /metrics
    respond @internal_metrics 404

    @auth_no_store path /auth /auth/*
    header @auth_no_store Cache-Control "no-store"
    header @auth_no_store Pragma "no-cache"

    @identity path /auth /auth/* /users /users/*
    handle @identity {
        reverse_proxy identity_service:8080
    }

    @community path /v1/community /v1/community/* /v1/reels /v1/reels/* /v1/forum /v1/forum/*
    handle @community {
        reverse_proxy community_service:8082
    }

    @news path /v1/news /v1/news/*
    handle @news {
        reverse_proxy news_service:8093
    }

    @orders path /v1/orders /v1/orders/* /v1/super-app/orders /v1/super-app/orders/*
    handle @orders {
        reverse_proxy order_service:8094
    }

    @payments path /v1/wallet /v1/wallet/* /v1/transactions /v1/transactions/*
    handle @payments {
        reverse_proxy payment_service:8095
    }

    @crm_api path /v1/crm /v1/crm/*
    handle @crm_api {
        reverse_proxy crm_service:8097
    }

    @communication_api path /v1/notifications /v1/notifications/*
    handle @communication_api {
        reverse_proxy communication_service:8098
    }

    handle {
        reverse_proxy marketplace_service:8081
    }

    encode zstd gzip
}

chat.{$APP_DOMAIN} {
    import access_log
    import security_headers
    @socket path /socket /socket/*
    @health path /api/health /api/ready
    handle @socket {
        reverse_proxy chat_service:4000
    }
    handle @health {
        reverse_proxy chat_service:4000
    }
    handle {
        respond 404
    }
}

cms.{$APP_DOMAIN} {
    import access_log
    import security_headers
    reverse_proxy cms:3001
    encode zstd gzip
}

crm.{$APP_DOMAIN} {
    import access_log
    import security_headers
    reverse_proxy crm:3002
    encode zstd gzip
}

media.{$APP_DOMAIN} {
    import access_log
    import security_headers
    reverse_proxy minio:9002
    encode zstd gzip
}

# Legacy alias retained while callers migrate to media.*.
cdn.{$APP_DOMAIN} {
    import access_log
    import security_headers
    reverse_proxy minio:9002
    encode zstd gzip
}
