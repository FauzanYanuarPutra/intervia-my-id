{
    email {$ADMIN_EMAIL}
}

(security_headers) {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    }
}

{$APP_DOMAIN} {
    redir https://www.{$APP_DOMAIN}{uri} permanent
}

www.{$APP_DOMAIN} {
    import security_headers
    @chat_socket path /socket /socket/*
    reverse_proxy @chat_socket chat_service:4000
    @notifications_socket path /v1/notifications/stream /v1/notifications/stream/*
    reverse_proxy @notifications_socket marketplace_service:8081
    reverse_proxy www:3000
    encode zstd gzip
}

usaha.{$APP_DOMAIN} {
    import security_headers
    @chat_socket path /socket /socket/*
    reverse_proxy @chat_socket chat_service:4000
    @notifications_socket path /v1/notifications/stream /v1/notifications/stream/*
    reverse_proxy @notifications_socket marketplace_service:8081
    reverse_proxy usaha:3003
    encode zstd gzip
}

api.{$APP_DOMAIN} {
    import security_headers

    @identity path /auth /auth/* /users /users/*
    handle @identity {
        reverse_proxy identity_service:8080
    }

    @community path /v1/community /v1/community/* /v1/reels /v1/reels/* /v1/forum /v1/forum/*
    handle @community {
        reverse_proxy community_service:8082
    }

    handle {
        reverse_proxy marketplace_service:8081
    }

    encode zstd gzip
}

chat.{$APP_DOMAIN} {
    import security_headers
    @socket path /socket /socket/*
    @health path /api/health /api/ready
    handle @socket {
        reverse_proxy chat_service:4000
    }
    handle @health {
        reverse_proxy chat_service:4000
    }
    handle {
        respond 404
    }
}

cms.{$APP_DOMAIN} {
    import security_headers
    reverse_proxy cms:3001
    encode zstd gzip
}

crm.{$APP_DOMAIN} {
    import security_headers
    reverse_proxy crm:3002
    encode zstd gzip
}

media.{$APP_DOMAIN} {
    import security_headers
    reverse_proxy minio:9002
    encode zstd gzip
}

# Legacy alias retained while callers migrate to media.*.
cdn.{$APP_DOMAIN} {
    import security_headers
    reverse_proxy minio:9002
    encode zstd gzip
}
