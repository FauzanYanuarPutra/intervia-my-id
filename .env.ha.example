# Optional HA overlay values. Do not commit real credentials.
# Copy to an operator-managed secret/env source before using docker-compose.ha.yml.

HA_IDENTITY_DATABASE_URL=postgres://identity_user:replace-me@identity-db.internal:5432/identity_db?sslmode=require
HA_MARKETPLACE_DATABASE_URL=postgres://marketplace_user:replace-me@marketplace-db.internal:5432/marketplace_db?sslmode=require
HA_COMMUNITY_DATABASE_URL=postgres://community_user:replace-me@community-db.internal:5432/community_db?sslmode=require

HA_REDIS_URL=rediss://:replace-me@redis.internal:6379/0
HA_REDIS_HOST=redis.internal
HA_REDIS_PASSWORD=replace-me

HA_RABBITMQ_URL=amqps://lajukan:replace-me@rabbitmq.internal:5671/%2f

HA_MEILI_URL=https://search.internal
HA_MEILI_MASTER_KEY=replace-me

HA_OBJECT_STORAGE_ENDPOINT=https://object-storage.internal
HA_OBJECT_STORAGE_ACCESS_KEY=replace-me
HA_OBJECT_STORAGE_SECRET_KEY=replace-me
HA_OBJECT_STORAGE_BUCKET=lajukan-media
HA_OBJECT_STORAGE_PUBLIC_URL=https://media.lajukan.com

# Shared replicated filesystem for Community uploads until Community moves to object storage.
HA_COMMUNITY_MEDIA_MOUNT=/mnt/lajukan-community-media
